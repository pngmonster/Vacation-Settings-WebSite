# Скопируйте в .env и при необходимости измените:  cp .env.example .env
# Файл .env не попадает в git (см. .gitignore). Реальные переменные окружения приоритетнее значений из .env.

# ======================================================================================
# База данных (общие для локального запуска и боевого сервера)
# ======================================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vacation
DB_USERNAME=vacation
DB_PASSWORD=vacation       # на боевом сервере ОБЯЗАТЕЛЬНО замените на длинный случайный пароль
DB_CHARSET=utf8
DB_SCHEMA=public
# В Docker DB_HOST/DB_PORT для приложения задаются в docker-compose*.yml (db:5432);
# DB_HOST/DB_PORT выше нужны только при запуске без Docker.

# ======================================================================================
# Локальная разработка (docker-compose.yml)
# ======================================================================================
# APP_PORT=8080          # порт сайта на вашей машине
# DB_PUBLISH_PORT=5433   # порт PostgreSQL на localhost (для psql/DBeaver)
# ADMINER_PORT=8081      # порт Adminer (docker compose --profile tools up)

# ======================================================================================
# Боевой сервер (docker-compose.prod.yml), см. docs/DEPLOYMENT.md
# ======================================================================================
# Домен сайта (на его IP должна указывать DNS A-запись) и почта для уведомлений Let's Encrypt:
# DOMAIN=example.org
# ACME_EMAIL=admin@example.org
# Чтобы команды `docker compose ...` на сервере сами использовали боевой файл:
# COMPOSE_FILE=docker-compose.prod.yml

# ======================================================================================
# Безопасность (см. docs/SECURITY.md)
# ======================================================================================
# APP_ENV: production (по умолчанию, если не задано) - вход только по HTTPS, пароль от 12 символов,
#          демо-вход закрыт. dev - только для локальных тестов (http и слабые пароли разрешены).
# В docker-compose.prod.yml APP_ENV=production и APP_TRUST_PROXY=1 заданы жёстко.
# APP_ENV=production
# APP_TRUST_PROXY=1       # сайт стоит за обратным прокси, который передаёт X-Forwarded-Proto / X-Forwarded-For
# ADMIN_IDLE_MINUTES=30   # автоматический выход при бездействии
# ADMIN_SESSION_HOURS=8   # предельная длительность одного входа
