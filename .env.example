# Скопируйте в .env и при необходимости измените:  cp .env.example .env
#
# Эти же переменные читает и само приложение (config.php), и docker compose.
# В Docker DB_HOST/DB_PORT для приложения задаются в docker-compose.yml (db:5432),
# значения ниже DB_HOST/DB_PORT нужны только при запуске без Docker.

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vacation
DB_USERNAME=vacation
DB_PASSWORD=vacation
DB_CHARSET=utf8
DB_SCHEMA=public

# Только для docker compose (необязательно):
# APP_PORT=8080          # порт сайта на вашей машине
# DB_PUBLISH_PORT=5433   # порт PostgreSQL на localhost (для psql/DBeaver)
# ADMINER_PORT=8081      # порт Adminer (docker compose --profile tools up)

# --- Безопасность администратора ---
# production (по умолчанию, если не задано) - вход только по HTTPS, пароль от 12 символов.
# dev - только для локальных тестов (http и слабые пароли разрешены).
# APP_ENV=production
# 1, если сайт стоит за обратным прокси (nginx, Traefik, Cloudflare...), который передаёт X-Forwarded-Proto и
# ПЕРЕЗАПИСЫВАЕТ X-Forwarded-For. Без этого за прокси сайт не поймёт, что соединение защищено, и вход будет закрыт.
# APP_TRUST_PROXY=1
# ADMIN_IDLE_MINUTES=30     # автоматический выход при бездействии
# ADMIN_SESSION_HOURS=8     # предельная длительность одного входа

